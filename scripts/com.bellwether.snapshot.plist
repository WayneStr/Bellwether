<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bellwether A0 每日快照（ROADMAP A0；安装/卸载见 scripts/README-snapshot-schedule.md） -->
    <key>Label</key>
    <string>com.bellwether.snapshot</string>
    <!-- 独立运行环境 ~/.bellwether/venv：launchd 进程无 TCC 授权，不能引用受保护的
         ~/Documents 下任何文件（含项目 .venv）。改动快照相关代码后需重装该环境：
         uv pip install --python ~/.bellwether/venv/bin/python /Users/YOUR_USERNAME/Documents/Bellwether -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/.bellwether/venv/bin/bellwether</string>
        <string>snapshot</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/.bellwether</string>
    <!-- 每日本地时间 08:30：A股/港股昨日收盘、美股当日凌晨收盘均已可得；
         笔记本睡眠错过的触发，launchd 会在唤醒后补跑一次 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.bellwether/logs/snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.bellwether/logs/snapshot.err.log</string>
</dict>
</plist>
